{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ringer.local/schemas/manifest.schema.json",
  "title": "Ringer manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_name",
    "workdir",
    "tasks"
  ],
  "properties": {
    "run_name": {
      "type": "string",
      "minLength": 1
    },
    "workdir": {
      "type": "string",
      "minLength": 1
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1
    },
    "worktrees": {
      "type": "boolean"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "external_expect_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "worktrees": {
            "const": true
          }
        },
        "required": [
          "worktrees"
        ]
      },
      "then": {
        "required": [
          "repo"
        ]
      }
    }
  ],
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "spec",
        "check"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "expect_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "full_access": {
          "type": "boolean"
        },
        "engine_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "task_type": {
          "type": "string"
        }
      }
    }
  }
}
